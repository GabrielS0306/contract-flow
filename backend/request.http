@baseUrl = http://localhost:3000

# Substitua pelos IDs reais de registros ativos
@clienteId = 6ace7f8183c4e2401f0caeb9
@sistemaId = 6ac684872adaa4e103234a0e
@contratoId = 6acfbb133ce6ef85696c4956


### ==========================================
### 1. AUTENTICAÇÃO
### ==========================================

### Criar usuário - execute somente se ainda não existir
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "nome": "Gabriel",
    "email": "gabriel@teste.com",
    "senha": "123456"
}


### Fazer login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "gabriel@teste.com",
    "senha": "123456"
}


### Testar rota protegida sem token - esperado: 401
GET {{baseUrl}}/auth/me


### Testar rota protegida com token
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.$.access_token}}


### ==========================================
### 2. CLIENTES
### ==========================================

### Criar cliente de teste - use documento ainda não cadastrado
# @name criarCliente
POST {{baseUrl}}/clients
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
    "nome": "Cliente Teste ContractFlow",
    "documento": "SUBSTITUA_POR_DOCUMENTO_UNICO",
    "email": "teste2@contractflow.com",
    "telefone": "(83) 98888-7777",
    "observacoes": "Cliente ativo para testes de contratos"
}


### Listar clientes
GET {{baseUrl}}/clients
Authorization: Bearer {{login.response.body.$.access_token}}


### Buscar cliente
GET {{baseUrl}}/clients/{{clienteId}}
Authorization: Bearer {{login.response.body.$.access_token}}


### Clientes sem autenticação - esperado: 401
GET {{baseUrl}}/clients


### Editar cliente
PATCH {{baseUrl}}/clients/{{clienteId}}
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
    "nome": "Empresa Exemplo Atualizada",
    "telefone": "(83) 98888-8888"
}


### Desativar cliente - execute somente quando desejado
PATCH {{baseUrl}}/clients/{{clienteId}}/deactivate
Authorization: Bearer {{login.response.body.$.access_token}}


### ==========================================
### 3. SISTEMAS
### ==========================================

### Criar sistema - execute somente se ainda não existir
# @name criarSistema
POST {{baseUrl}}/systems
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
    "nome": "ContractFlow",
    "descricao": "Sistema para gerenciamento de contratos e licenças de software",
    "versao": "1.0.0"
}


### Listar sistemas
GET {{baseUrl}}/systems
Authorization: Bearer {{login.response.body.$.access_token}}


### Buscar sistema
GET {{baseUrl}}/systems/{{sistemaId}}
Authorization: Bearer {{login.response.body.$.access_token}}


### Sistemas sem autenticação - esperado: 401
GET {{baseUrl}}/systems


### Atualizar sistema
PATCH {{baseUrl}}/systems/{{sistemaId}}
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
    "descricao": "Sistema completo para gerenciamento de contratos e licenças",
    "versao": "1.1.0"
}


### Desativar sistema - execute somente quando desejado
PATCH {{baseUrl}}/systems/{{sistemaId}}/deactivate
Authorization: Bearer {{login.response.body.$.access_token}}


### ==========================================
### 4. CONTRATOS
### ==========================================

### Criar contrato
# @name criarContrato
POST {{baseUrl}}/contracts
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
    "numero": "CONT-2026-001",
    "clienteId": "{{clienteId}}",
    "sistemaId": "{{sistemaId}}",
    "periodicidade": "MENSAL",
    "valor": 199.90,
    "valorImplantacao": 500,
    "dataInicio": "2026-10-13T00:00:00.000Z",
    "dataFim": "2027-10-13T00:00:00.000Z",
    "diaVencimento": 10,
    "observacoes": "Contrato de teste do ContractFlow"
}

### Listar contratos
GET {{baseUrl}}/contracts
Authorization: Bearer {{login.response.body.$.access_token}}

### Buscar contrato
GET {{baseUrl}}/contracts/{{contratoId}}
Authorization: Bearer {{login.response.body.$.access_token}}

### Atualizar contrato
PATCH {{baseUrl}}/contracts/{{contratoId}}
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
    "valor": 249.90,
    "observacoes": "Valor atualizado para teste"
}


### Reativar contrato
PATCH {{baseUrl}}/contracts/{{contratoId}}/activate
Authorization: Bearer {{login.response.body.$.access_token}}


### Encerrar contrato - execute somente quando desejado
PATCH {{baseUrl}}/contracts/{{contratoId}}/deactivate
Authorization: Bearer {{login.response.body.$.access_token}}
